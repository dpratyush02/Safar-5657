{
  "buildCommand": "bun run --cwd packages/web build",
  "installCommand": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 bun install",
  "outputDirectory": "packages/web/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/packages/web/api/[[...route]]" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
