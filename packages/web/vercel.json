{
  "buildCommand": "bun run build",
  "installCommand": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 bun install",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[[...route]]" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
